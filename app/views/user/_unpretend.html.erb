<% if session[:real_user_id] %>
  <div class="flash error">
    <%= l(:label_logged_as) %> <%= User.current.login %> (<%= User.current.name %>).
    <%= l(:pretend_message) %> <%= real_user %>
    <%= link_to l(:button_unpretend), unpretend_path, :class => 'icon', :method => :post %>
  </div>
<% end %>
